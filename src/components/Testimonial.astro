---
import quote from "../assets/quotes.png"
import heroBG from '../assets/testimonial-bg.png';
---

<div class="testimonial-area">
	<div class="container">
		
		<div class="testimonial text-white d-flex align-items-center" style={`background-image: url(${heroBG.src})`} data-aos="fade-up" data-aos-delay="200">
			<div class="w-100">
				<div class="row">
					<div class="col-6 col-md-3">
						<h3>10+</h3>
						<p>Years of expertise led by our Lead Designer.</p>
					</div>
					<!-- /.col-6 col-md-3 -->
					<div class="col-6 col-md-3">
						<h3>208+</h3>
						<p>Premium 1-to-1 custom product projects completed.</p>
					</div>
					<!-- /.col-6 col-md-3 -->
					<div class="col-6 col-md-3">
						<h3>100%</h3>
						<p>Seamless international timezone execution.</p>
					</div>
					<!-- /.col-6 col-md-3 -->
					<div class="col-6 col-md-3">
						<h3>24h-48h</h3>
						<p>Avg. turnaround execution for active queue tasks.</p>
					</div>
					<!-- /.col-6 col-md-3 -->
				</div>
				<!-- /.row -->
			</div>
			<!-- /.w-100 -->
		</div>

		<div class="d-flex justify-content-center"><img src={quote.src} alt="quote" /></div>

		<div class="testimonial-cards">
			<div class="row">
				<div class="col-md-4">
					<p><em>“Outstanding system-level design thinking. The design feels cohesive from top to bottom, with every section belonging to the same visual system. Highly recommended for anyone looking for premium, system-led design rather than surface-level visuals.”</em></p>

					<p><small>- Lumenaus</small></p>
				</div>
				<!-- /.col-md-4 -->
				<div class="col-md-4">
					<p><em>“The result is absolutely excellent - I’m really happy with the outcome. As always, they worked super reliably, communicated clearly, and delivered everything on point. Top collaboration, highly recommended!”</em></p>

					<p><small>- infoqrg</small></p>
				</div>
				<!-- /.col-md-4 -->
				<div class="col-md-4">
					<p><em>“Amazing work and very patient and responsive. Always grateful to work together. Has such a great understanding for clients’ needs and a great turnaround time.”</em></p>

					<p><small>- thestartupkit</small></p>
				</div>
				<!-- /.col-md-4 -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.testimonial-cards -->
	</div>
</div>



<style>
	.testimonial-area{
		padding-top: 120px;
		padding-bottom: 70px;
	}

	.testimonial{
		background-position: center bottom;
		background-size: cover;
		border-radius: 16px;
		margin-bottom: 70px;
		padding: 25px 80px;
		min-height: 310px;
	}

	.testimonial-cards{
		border: 1px solid #d2d3de;
		border-radius: 16px;
		overflow: hidden;
		margin-top: -15px;
	}
	
	.testimonial-cards .row > div{
		border-left: 1px solid #d2d3de;
		padding: 2.5em;
	}

	.testimonial-cards p:first-child{
		min-height: 200px;
	}

	.testimonial-cards p:last-child{
		margin-bottom: 0;
	}

	.testimonial-cards p{
		color: #000;
		font-size: 19px;
	}

	.testimonial-cards p small{
		font-size: 0.9em;
	}

	h3{
		font-size: 50px;
		font-weight: 800;
		margin-bottom: 5px;
	}

	strong{
		font-weight: 600;
	}

	.testimonial p{
		max-width: 220px;
		font-size: 17px;
		width: 100%;
	}

	@media screen and (max-width: 1199px){

		.testimonial p, .testimonial-cards p{
			font-size: 15px;
		}

		.testimonial{
			padding: 25px 40px;
		}

		h3{
			font-size: 40px;
		}

		.testimonial-cards p:first-child{
			min-height: 150px;
		}
	}

	@media screen and (max-width: 767px) {
		.testimonial p{
			font-size: 12px;
		}

		h3{
			font-size: 30px;
		}

		.testimonial{
			padding: 25px 20px;
		}

		.testimonial-cards .row > div{
			border-left: none;
			border-bottom: 1px solid #d2d3de;
		}
	}
</style>
