---
import footerBG from '../assets/footer-bg.png';
import FooterBottom from './FooterBottom.astro';
---

<div class="footer">
	<div class="scaler" style={`background-image: url(${footerBG.src})`}>
		<div class="container">
			<div class="heading text-center text-white" data-aos="fade-up" data-aos-delay="200">
				<h2>Need Immediate Assistance?</h2>
				<p>Have questions about your onboarding or setup? <br />Drop us a line at <a href="mailto:hello@flexipixels.com" class="text-white"><strong>hello@flexipixels.com</strong></a> and we’ll get you sorted out right away.</p>
				<a href="/#plans" class="btn btn-lg rounded-pill btn-outline-white">get help</a>
			</div>
			<!-- /.heading -->
		</div>
		<!-- /.container -->
	</div>

	<FooterBottom />
</div>


<style>
	.footer{
		background-color: #e7e8f6;
	}

	.scaler{
		padding-top: 100px;
		padding-bottom: 160px;
		background-size: cover;
		background-position: center center;
	}

	.heading{
		margin: auto;
		width: 100%
	}

	strong{
		font-weight: 600;
	}

	h6{
		color: #91a3e7;
		margin-bottom: 16px;
	}

	h2{
		color: #fff;
		font-size: 45px;
		margin-bottom: 20px;
	}

	p{
		margin-bottom: 30px;
	}

	h5{
		color: #121d46;
	}
</style>
