---
import footerBG from '../assets/footer-bg.png';
import footerLogo from '../assets/footer-logo.png';
import FB from '../assets/facebook-icon.png';
import Insta from '../assets/instagram-icon.png';
---

<div class="footer">
	<div class="scaler" style={`background-image: url(${footerBG.src})`}>
		<div class="container">
			<div class="heading text-center text-white">
				<h6 class="text-uppercase">Ready to scale?</h6>
				<h2>Simplify Your <br />Design Workflow Today.</h2>
				<p>Secure your dedicated design support and get your first delivery in 24–48 hours. No hidden charges, cancel anytime.</p>
				<a href="#" class="btn btn-lg rounded-pill btn-red">Get Started</a>
			</div>
			<!-- /.heading -->
		</div>
		<!-- /.container -->
	</div>

	<div class="footer-bottom">
		<div class="container">
			<div class="footer-strip d-flex flex-column flex-md-row align-items-center justify-content-between gap-4">
				<div class="footer-logo">
					<img src={footerLogo.src} alt="Footer Logo" />
				</div>
				<!-- /.footer-logo -->

				<ul class="list-unstyled mb-0 d-flex align-items-center gap-4 flex-wrap">
					<li><a href="#">Services</a></li>
					<li><a href="#">Our Work</a></li>
					<li><a href="#">How It Works</a></li>
					<li><a href="#">Pricing</a></li>
					<li><a href="#">FAQ</a></li>
				</ul>

				<div class="footer-control d-flex align-items-center gap-3">
					<a href="mailto:hello@flexipixels.com">hello@flexipixels.com</a>
					<a href="#"><img src={FB.src} alt="Facebook" /></a>
					<a href="#"><img src={Insta.src} alt="Instagram" /></a>
				</div>
				<!-- /.footer-control -->
			</div>
			<!-- /.footer-strip -->

			<div class="row">
				<div class="col-md-6">
					<p>© 2026 FlexiPixels. All Rights Reserved.</p>
				</div>
				<!-- /.col-md-6 -->
				<div class="col-md-6 d-flex justify-content-md-end justify-content-center gap-4">
					<a href="#">Terms of Service</a>
					<a href="#">Privacy Policy</a>
				</div>
				<!-- /.col-md-6 -->
			</div>
			<!-- /.row -->		
		</div>
	</div>
</div>


<style>
	.footer{
		background-color: #e7e8f6;
	}

	.footer-bottom{
		font-size: 15px;
		padding-bottom: 40px;
	}

	.footer-strip{
		margin-bottom: 30px;
		margin-top: -40px;
	}

	.footer-strip li a{
		color: #121d46;
	}
	
	.footer-bottom p, .footer-bottom a{
		color: #a7a8bc;
		margin-bottom: 0;
	}

	.footer-bottom a{
		text-decoration: none;
	}

	.footer-bottom a:hover{
		text-decoration: underline;
		color: #7070ff;		
	}

	.scaler{
		padding-top: 100px;
		padding-bottom: 160px;
		background-size: cover;
		background-position: center center;
	}

	.heading{
		max-width: 580px;
		margin: auto;
		width: 100%
	}

	strong{
		font-weight: 600;
	}

	h6{
		color: #3d60e2;
		margin-bottom: 16px;
	}

	h2{
		color: #fff;
		font-size: 45px;
		margin-bottom: 20px;
	}

	p{
		margin-bottom: 30px;
	}

	h5{
		color: #121d46;
	}

	.footer-strip{
		background-color: #fff;
		border-radius: 16px;
		padding: 50px 45px;
	}
</style>
