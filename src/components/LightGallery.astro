</div>

<div class="d-flex justify-content-center mt-4">
    <a href="#" id="open-gallery-btn" class="btn btn-xl rounded-pill btn-blue">Our work</a>
</div>

<script>
    // JS import remains in the client-side script tag
    import lightGallery from 'lightgallery';

    const galleryElement = document.getElementById('lightgallery');
    const openButton = document.getElementById('open-gallery-btn');
    
    if (galleryElement && openButton) {
        // Initialize lightGallery on the hidden container
        lightGallery(galleryElement, {
            speed: 500,
            download: false
        });

        // Listen for the button click
        openButton.addEventListener('click', (e) => {
            e.preventDefault(); // Prevents the page from jumping to the top due to href="#"
            
            // Programmatically click the first image in the hidden gallery to trigger the popup
            const firstImage = galleryElement.querySelector('a');
            if (firstImage) {
                firstImage.click();
            }
        });
    }
</script>