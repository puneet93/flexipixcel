---
import Checkicon from "../assets/check-green-lg.png"
import workIcon1 from "../assets/thank-u-icon1.png"
import workIcon2 from "../assets/thank-u-icon2.png"
import workIcon3 from "../assets/thank-u-icon3.png"
---

<div class="nav-u">
	<div class="works" id="works">
		<div class="container">
			<div class="heading text-center" data-aos="fade-up" data-aos-delay="200">
				<img src={Checkicon.src} alt="check" class="mb-3" />
				<h2>Thank you for choosing FlexiPixels.</h2>
				<p>Your private workspace is ready. Check your inbox to begin.</p>
			</div>
			<!-- /.heading -->

			<div class="row g-3 justify-content-center">
				<div class="col-lg-4 col-sm-6 col-12" data-aos="fade-up" data-aos-delay="200">
					<div class="work d-flex flex-column">
						<div class="work-image d-flex align-items-center justify-content-center">
							<img src={workIcon1.src} alt="workIcon1" class="img-fluid" />
						</div>
						<!-- /.service-image -->

						<div class="work-info">
							<h3><sup>01</sup> Check Your Inbox.</h3>
							<p>An automated onboarding link has been sent to your inbox.</p>
						</div>
						<!-- /.service-info -->
					</div>
					<!-- /.service -->
				</div>
				<!-- /.col-lg-4 col-sm-6 col-12 -->
				<div class="col-lg-4 col-sm-6 col-12" data-aos="fade-up" data-aos-delay="400">
					<div class="work d-flex flex-column">
						<div class="work-image d-flex align-items-center justify-content-center">
							<img src={workIcon2.src} alt="workIcon2" class="img-fluid" />
						</div>
						<!-- /.service-image -->

						<div class="work-info">
							<h3><sup>02</sup> Join Trello.</h3>
							<p>Click the secure link to access your private design board.</p>
						</div>
						<!-- /.service-info -->
					</div>
					<!-- /.service -->
				</div>
				<!-- /.col-lg-4 col-sm-6 col-12 -->
				<div class="col-lg-4 col-sm-6 col-12" data-aos="fade-up" data-aos-delay="600">
					<div class="work d-flex flex-column">
						<div class="work-image d-flex align-items-center justify-content-center">
							<img src={workIcon3.src} alt="workIcon3" class="img-fluid" />
						</div>
						<!-- /.service-image -->

						<div class="work-info">
							<h3><sup>03</sup> Start Your First Request.</h3>
							<p>Review the guide, drop your brand assets, and log your first project.</p>
						</div>
						<!-- /.service-info -->
					</div>
					<!-- /.service -->
				</div>
				<!-- /.col-lg-4 col-sm-6 col-12 -->
			</div>
			<!-- /.row -->
		</div>
	</div>
</div>



<style>
	.nav-u{
		padding-top: 128px;
		background-color: #121d45;
	}
	.works{
		background-color: #fff;
		padding-bottom: 85px;
		padding-top: 85px;
		position: relative;
	}

	.services .row{
		margin-bottom: 60px;
	}

	.heading{
		margin-bottom: 60px;
	}

	h6{
		color: #3d60e2;
	}

	h2{
		color: #121d46;
	}

	h3{
		color: #121d46;
		font-size: 27px;
		font-weight: 800;
		margin-bottom: 16px;
	}

	sup{
		top: -0.4em;
		font-size: 18px;
		color: #5f72bb;
		font-weight: 800;
		margin-right: 12px;
	}

	.work{
		transition: all 0.35s linear;
		background-color: #f3f4fc;
		padding: 40px 40px 50px;
		text-decoration: none;
		border-radius: 16px;
		overflow: hidden;
		color: #121d46;
		min-height: 100%;
	}

	.work-info p{
		margin-bottom: 0;
	}

	.work-info h6{
		color: #5f72bb;
	}

	.work-image{
		flex-grow: 1;
		margin-bottom: 40px;
	}

	@media screen and (max-width: 767px){
		.nav-u{
			padding-top: 107px;
		}
	}
</style>
